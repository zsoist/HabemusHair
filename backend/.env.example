# ============================================================
# VARIABLES DE ENTORNO — EJEMPLO
# ============================================================
# Copia este archivo como .env y cambia los valores:
#   cp .env.example .env
#
# NUNCA subas el archivo .env real a Git (tiene credenciales).
# ============================================================

# Base de datos
DATABASE_URL=postgresql://habemus:habemus_dev@localhost:5432/habemus_hair

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (almacenamiento de fotos)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=habemus-images

# Seguridad — CAMBIAR en produccion
SECRET_KEY=genera-un-string-aleatorio-de-al-menos-32-caracteres-aqui

# Debug
DEBUG=true
